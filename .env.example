# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Google Sheets Direct Integration ---
# Option A: Paste your Google Sheet ID (from the sheet URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Option B (Fastest, zero-credentials): Google Apps Script Webhook URL
# Deploy the provided Apps Script as a Web App and paste the Exec URL here:
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# --- Auto-Confirmation Notification Webhook (Optional) ---
# When kitchen accepts order, webhook receives automated customer confirmation payload:
NOTIFICATION_WEBHOOK_URL="https://your-sms-or-whatsapp-webhook.com/api/notify"
