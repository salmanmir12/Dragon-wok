{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator with full platform control",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Admin email address" },
        "role": { "type": "string", "enum": ["admin"], "description": "Role string" },
        "createdAt": { "type": "string", "description": "Timestamp when admin access was granted" }
      },
      "required": ["email", "role"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Restaurant staff member authorized to view orders and update statuses",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Staff member email" },
        "name": { "type": "string", "description": "Staff member name" },
        "role": { "type": "string", "enum": ["staff"], "description": "Role string" },
        "createdAt": { "type": "string", "description": "Timestamp when staff access was granted" }
      },
      "required": ["email", "name", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile, preferences, and saved addresses",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "maxLength": 100, "description": "Customer full name" },
        "email": { "type": "string", "format": "email", "description": "Account email" },
        "phone": { "type": "string", "maxLength": 25, "description": "Customer phone number" },
        "addresses": { "type": "array", "description": "List of saved delivery addresses" },
        "favorites": { "type": "array", "description": "List of favorite menu item IDs" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Profile update timestamp" }
      },
      "required": ["userId", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Restaurant order placed by customer or guest",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Human-friendly unique order reference" },
        "userId": { "type": "string", "description": "Customer Firebase Auth UID or guest identifier" },
        "customerName": { "type": "string", "maxLength": 100, "description": "Customer name for contact" },
        "customerPhone": { "type": "string", "maxLength": 25, "description": "Customer phone number" },
        "orderType": { "type": "string", "enum": ["delivery", "pickup"], "description": "Fulfillment type" },
        "deliveryAddress": { "type": "string", "maxLength": 500, "description": "Delivery address" },
        "notes": { "type": "string", "maxLength": 500, "description": "Special order instructions" },
        "items": { "type": "array", "description": "Ordered food items list" },
        "subtotal": { "type": "number", "description": "Subtotal in PKR" },
        "deliveryFee": { "type": "number", "description": "Delivery fee in PKR" },
        "total": { "type": "number", "description": "Grand total in PKR" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Preparing", "Ready", "Out for Delivery", "Completed", "Cancelled"],
          "description": "Current order lifecycle status"
        },
        "paymentMethod": { "type": "string", "enum": ["cod", "counter"], "description": "Payment method" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Status or details update timestamp" }
      },
      "required": ["orderId", "userId", "customerName", "customerPhone", "orderType", "items", "total", "status"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Dragon Wok menu item managed dynamically by administrators",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120, "description": "Dish title" },
        "category": { "type": "string", "maxLength": 50, "description": "Menu category" },
        "price": { "type": "number", "description": "Regular price in PKR" },
        "familyPrice": { "type": "number", "description": "Optional family portion price in PKR" },
        "description": { "type": "string", "maxLength": 500, "description": "Dish description" },
        "image": { "type": "string", "description": "Image URL or local image path" },
        "available": { "type": "boolean", "description": "Whether the dish is currently in stock" },
        "badge": { "type": "string", "maxLength": 50, "description": "Optional badge label" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" }
      },
      "required": ["name", "category", "price", "available"]
    },
    "RestaurantSettings": {
      "title": "RestaurantSettings",
      "description": "Configurable operational settings for Dragon Wok",
      "type": "object",
      "properties": {
        "isOpenOverride": { "type": "boolean", "description": "Manual override for open/closed status" },
        "announcement": { "type": "string", "maxLength": 300, "description": "Live announcement banner" },
        "deliveryFee": { "type": "number", "description": "Standard delivery fee in PKR" },
        "estimatedDeliveryTime": { "type": "string", "description": "Estimated delivery timeframe" },
        "phone": { "type": "string", "description": "Restaurant contact phone" },
        "address": { "type": "string", "description": "Restaurant physical location" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["deliveryFee", "phone"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Collection of verified administrator accounts"
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Collection of verified restaurant staff members"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer profiles containing private contact details and saved addresses"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders placed by customers and tracked in real time"
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Live dynamic restaurant menu items and pricing"
    },
    "/restaurant_settings/{settingId}": {
      "schema": { "$ref": "#/entities/RestaurantSettings" },
      "description": "Restaurant operational settings and live announcements"
    }
  }
}
